def redact_str: gsub("(?P<k>(password|passwd|access_token|client_secret|api_key|api-key|apikey|token|secret|pass|auth|sig)[[:punct:]]?=)[^&; ']+"; .k + "****"; "i") | gsub("(?P<k>--password[[:space:]]+)[^[:space:]]+"; .k + "****"; "i") | gsub("(?P<k>bearer[[:space:]]+)[^[:space:]&;']+"; .k + "****"; "i") | if test("mysql|mariadb"; "i") then gsub("(?P<k>(^|[[:space:]])-p)[^[:space:]]+"; .k + "****") else . end; def redact: . as $o | walk(if type == "string" then redact_str else . end) as $r | $r + {secrets_redacted: ($r != $o)}; def nz: if . == null or . == "" then null else . end; def num: if . == null or . == "" then null else (tonumber? // .) end; (((.message // "") | tostring) | split(",")) as $f | ($f[3] | nz) as $lt | ($f[30] | nz) as $va | (($va // "") | ascii_downcase) as $val | . + {log_type: $lt, log_subtype: ($f[4] | nz), src: ($f[7] | nz), dest: ($f[8] | nz), rule: ($f[11] | nz), user: ($f[12] | nz), app: ($f[14] | nz), src_zone: ($f[16] | nz), dest_zone: ($f[17] | nz), session_id: ($f[22] | num), src_port: ($f[24] | num), dest_port: ($f[25] | num), transport: ($f[29] | nz), vendor_action: $va, action: (if $val == "allow" or $val == "alert" then "allowed" else "blocked" end), vendor_product: "Palo Alto Networks PAN-OS", index: "netfw", sourcetype: (if $lt == "THREAT" then "pan:threat" else "pan:traffic" end)} | (if $lt == "TRAFFIC" then . + {bytes: ($f[31] | num), bytes_out: ($f[32] | num), bytes_in: ($f[33] | num), packets: ($f[34] | num), duration: ($f[36] | num)} elif $lt == "THREAT" then (((($f[32] // "") | capture("^(?P<n>.*?)[[:space:]]*[(](?P<id>[0-9]+)[)][[:space:]]*$")) // {}) as $t | . + {threat_name: ($t.n // ($f[32] | nz)), threat_id: ($t.id | num), threat_category: ($f[33] | nz), severity: ($f[34] | nz), threat_direction: ($f[35] | nz)}) else . end) | redact
