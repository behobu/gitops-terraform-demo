def ti_prefixes: ["185.220.101.", "45.155.205.", "193.32.162.", "218.92.0.", "61.177.172.", "80.94.95.", "141.98.11."]; def ti_listed: if type == "string" then (. as $ip | any(ti_prefixes[]; . as $p | $ip | startswith($p))) else false end; def zone: if . == null or . == "" then "unknown" elif (type == "string" and test("^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$")) then ((split(".") | map(tonumber)) as $o | if $o[0] == 10 and $o[1] == 40 and $o[2] == 0 then "pci" elif $o[0] == 10 and $o[1] == 30 and $o[2] == 0 then "datacenter" elif $o[0] == 10 and $o[1] == 20 and $o[2] == 0 then "dmz" elif $o[0] == 10 and $o[1] == 10 then "corp" elif $o[0] == 10 or ($o[0] == 172 and $o[1] >= 16 and $o[1] <= 31) or ($o[0] == 192 and $o[1] == 168) then "internal" else "external" end) else "external" end; def hostzone: if . == null or . == "" then "unknown" else ((tostring | ascii_downcase | split(".") | .[0]) as $h | if $h == "web01" or $h == "web02" or $h == "bastion01" then "dmz" elif $h == "db01" or $h == "app01" then "datacenter" else "internal" end) end; def crit: if . == "pci" then "critical" elif . == "datacenter" or . == "dmz" then "high" elif . == "corp" or . == "internal" then "medium" elif . == "external" then "unmanaged" else "unknown" end; def ucat: if . == null or . == "" then "unknown" else ((([(tostring | match("[A-Za-z0-9_.@$-]+"; "g")) | .string] | last) // "") | ascii_downcase) as $u | (if $u == "" then "unknown" elif $u == "root" or $u == "admin" or $u == "administrator" then "privileged" elif ($u | test("^(svc_|svc-|sa_)")) then "service" else "standard" end) end; def geo_country: if type == "object" and (.data | type) == "object" then (.data.country // null) else null end; def geo_stat: if type != "object" then "not_enriched" elif (.data | type) == "object" then "ok" else (.code // "not_enriched") end; (.src // null) as $src | (if $src == null or $src == "" then "local" else ($src | zone) end) as $sz | (.dest | hostzone) as $dz | ($dz | crit) as $dc | (if $sz == "local" then "local" elif $sz == "external" then "inbound" else "internal" end) as $dir | (.enrichment.geo.src // null) as $gs | ($gs | geo_country) as $scn | ($src | ti_listed) as $ti | (.user | ucat) as $uc | (.category // "") as $cat | (.action // "") as $act | ($cat == "authentication" and $act == "failure") as $fail | ($cat == "authentication" and $act == "success") as $succ | ($sz == "external") as $ext | ($cat == "privilege_escalation") as $sudo | ((.command // "") | tostring | ascii_downcase) as $cmd | ($sudo and ($cmd | test("/etc/shadow"))) as $c_shadow | ($sudo and ($cmd | test("(^|[^a-z])(useradd|usermod|adduser)([^a-z]|$)"))) as $c_user | ($sudo and ($cmd | test("(curl|wget)[^|]*[|][[:space:]]*(sudo[[:space:]]+)?[a-z/]*(ba|z|da|k)?sh([^a-z]|$)"))) as $c_pipe | ($sudo and ($cmd | test("chmod[[:space:]]+(-[a-z]+[[:space:]]+)*0?777"))) as $c_chmod | (.secrets_redacted == true) as $cred | ($scn != null and any("CN", "RU", "KP", "IR"; . == $scn)) as $hrc | [(if $fail and $ext then "failed_login_external" else empty end), (if $fail and ($ext | not) then "failed_login_internal" else empty end), (if .user_valid == false then "invalid_username" else empty end), (if $succ and $ext then "successful_login_external" else empty end), (if $cat == "authentication" and $uc == "privileged" then "privileged_account_login" else empty end), (if $sudo then "sudo" else empty end), (if $c_shadow then "sudo_shadow_access" else empty end), (if $c_user then "sudo_account_change" else empty end), (if $c_pipe then "sudo_download_pipe_shell" else empty end), (if $c_chmod then "sudo_chmod_777" else empty end), (if $cred then "credential_on_command_line" else empty end), (if $ti then "threat_intel_source" else empty end), (if $hrc then "high_risk_country" else empty end)] as $rf | {failed_login_external: 30, failed_login_internal: 10, invalid_username: 15, successful_login_external: 50, privileged_account_login: 20, sudo: 15, sudo_shadow_access: 50, sudo_account_change: 50, sudo_download_pipe_shell: 50, sudo_chmod_777: 50, credential_on_command_line: 50, threat_intel_source: 20, high_risk_country: 10} as $w | ([$rf[] | $w[.]] | add // 0 | if . > 100 then 100 else . end) as $score | ([(if $fail and $ext then "T1110" else empty end), (if $succ and $ext then "T1078" else empty end), (if $sudo then "T1548.003" else empty end), (if $c_shadow then "T1003.008" else empty end), (if $c_user then "T1136.001" else empty end), (if $c_pipe then "T1059.004" else empty end), (if $c_chmod then "T1222.002" else empty end), (if $cred then "T1552.001" else empty end)] | unique) as $mitre | (if $cat == "session" then "cold" elif $score >= 30 then "hot" else "warm" end) as $tier | . + {src_network_zone: $sz, dest_network_zone: $dz, direction: $dir, dest_asset_criticality: $dc, user_category: $uc, src_country: $scn, geo_status: {src: ($gs | geo_stat)}, threat_intel: {src_listed: $ti, source: "demo-static-blocklist"}, risk_factors: $rf, risk_score: $score, mitre_technique: $mitre, tier: $tier}
