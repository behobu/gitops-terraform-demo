def ti_prefixes: ["185.220.101.", "45.155.205.", "193.32.162.", "218.92.0.", "61.177.172.", "80.94.95.", "141.98.11."]; def ti_listed: if type == "string" then (. as $ip | any(ti_prefixes[]; . as $p | $ip | startswith($p))) else false end; def zone: if . == null or . == "" then "unknown" elif (type == "string" and test("^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$")) then ((split(".") | map(tonumber)) as $o | if $o[0] == 10 and $o[1] == 40 and $o[2] == 0 then "pci" elif $o[0] == 10 and $o[1] == 30 and $o[2] == 0 then "datacenter" elif $o[0] == 10 and $o[1] == 20 and $o[2] == 0 then "dmz" elif $o[0] == 10 and $o[1] == 10 then "corp" elif $o[0] == 10 or ($o[0] == 172 and $o[1] >= 16 and $o[1] <= 31) or ($o[0] == 192 and $o[1] == 168) then "internal" else "external" end) else "external" end; def crit: if . == "pci" then "critical" elif . == "datacenter" or . == "dmz" then "high" elif . == "corp" or . == "internal" then "medium" elif . == "external" then "unmanaged" else "unknown" end; def ucat: if . == null or . == "" then "unknown" else ((([(tostring | match("[A-Za-z0-9_.@$-]+"; "g")) | .string] | last) // "") | ascii_downcase) as $u | (if $u == "" then "unknown" elif $u == "root" or $u == "admin" or $u == "administrator" then "privileged" elif ($u | test("^(svc_|svc-|sa_)")) then "service" else "standard" end) end; def geo_country: if type == "object" and (.data | type) == "object" then (.data.country // null) else null end; def geo_stat: if type != "object" then "not_enriched" elif (.data | type) == "object" then "ok" else (.code // "not_enriched") end; def direction($sz; $dz): if $sz == "external" and $dz != "external" then "inbound" elif $sz != "external" and $dz == "external" then "outbound" else "internal" end; .src as $src | .dest as $dest | ($src | zone) as $sz | ($dest | zone) as $dz | ($dz | crit) as $dc | direction($sz; $dz) as $dir | (.enrichment.geo.src // null) as $gs | (.enrichment.geo.dest // null) as $gd | ($gs | geo_country) as $scn | ($gd | geo_country) as $dcn | ($src | ti_listed) as $ti | (.log_type == "THREAT") as $threat | ((.severity // "") | tostring | ascii_downcase) as $tsev | (.dest_port | if . == null then null elif type == "number" then . else (tonumber? // null) end) as $dp | ($dp != null and any(22, 23, 445, 1433, 3306, 3389, 5900; . == $dp)) as $risky | ($dir == "inbound") as $inb | (.action == "allowed") as $allowed | (.action == "blocked") as $blocked | ($sz == "corp" and $dz == "pci" and $risky) as $corppci | ($ti and $allowed and $inb) as $badallowed | (.secrets_redacted == true) as $cred | ((((.threat_name // "") | tostring) + " " + ((.threat_category // "") | tostring) + " " + ((.log_subtype // "") | tostring)) | ascii_downcase) as $tt | ($scn != null and any("CN", "RU", "KP", "IR"; . == $scn)) as $hrc | [(if $threat then "threat_log" else empty end), (if $threat and ($tsev == "critical" or $tsev == "high") then "threat_severity_high" else empty end), (if $ti then "threat_intel_source" else empty end), (if $inb and $risky then "inbound_risky_port" else empty end), (if $badallowed then "known_bad_allowed_inbound" else empty end), (if $corppci then "corp_to_pci_risky_port" else empty end), (if $dc == "critical" then "critical_destination" else empty end), (if $hrc then "high_risk_country" else empty end), (if $cred then "credential_in_log" else empty end)] as $rf | {threat_log: 40, threat_severity_high: 20, threat_intel_source: 25, inbound_risky_port: 20, known_bad_allowed_inbound: 30, corp_to_pci_risky_port: 45, critical_destination: 10, high_risk_country: 10, credential_in_log: 20} as $w | ([$rf[] | $w[.]] | add // 0 | if . > 100 then 100 else . end) as $score | ([(if $threat and ($tt | test("brute")) then "T1110" else empty end), (if $threat and ($tt | test("code[- ]?exec|remote code|(^|[^a-z])rce([^a-z]|$)")) then "T1190" else empty end), (if $blocked and $inb and $risky then "T1046" else empty end), (if $corppci then "T1021" else empty end), (if $badallowed then "T1133" else empty end), (if $cred then "T1552.001" else empty end)] | unique) as $mitre | (if $threat or $score >= 50 or ($blocked and $dc == "critical") then "hot" elif $allowed and ($sz != "external" and $sz != "unknown") and ($dz != "external" and $dz != "unknown") and $score < 20 then "cold" else "warm" end) as $tier | . + {src_network_zone: $sz, dest_network_zone: $dz, direction: $dir, dest_asset_criticality: $dc, user_category: (.user | ucat), src_country: $scn, dest_country: $dcn, geo_status: {src: ($gs | geo_stat), dest: ($gd | geo_stat)}, threat_intel: {src_listed: $ti, source: "demo-static-blocklist"}, risk_factors: $rf, risk_score: $score, mitre_technique: $mitre, tier: $tier}
