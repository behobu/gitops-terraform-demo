def ti_prefixes: ["185.220.101.", "45.155.205.", "193.32.162.", "218.92.0.", "61.177.172.", "80.94.95.", "141.98.11."]; def ti_listed: if type == "string" then (. as $ip | any(ti_prefixes[]; . as $p | $ip | startswith($p))) else false end; def zone: if . == null or . == "" then "unknown" elif (type == "string" and test("^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$")) then ((split(".") | map(tonumber)) as $o | if $o[0] == 10 and $o[1] == 40 and $o[2] == 0 then "pci" elif $o[0] == 10 and $o[1] == 30 and $o[2] == 0 then "datacenter" elif $o[0] == 10 and $o[1] == 20 and $o[2] == 0 then "dmz" elif $o[0] == 10 and $o[1] == 10 then "corp" elif $o[0] == 10 or ($o[0] == 172 and $o[1] >= 16 and $o[1] <= 31) or ($o[0] == 192 and $o[1] == 168) then "internal" else "external" end) else "external" end; def crit: if . == "pci" then "critical" elif . == "datacenter" or . == "dmz" then "high" elif . == "corp" or . == "internal" then "medium" elif . == "external" then "unmanaged" else "unknown" end; def geo_country: if type == "object" and (.data | type) == "object" then (.data.country // null) else null end; def geo_stat: if type != "object" then "not_enriched" elif (.data | type) == "object" then "ok" else (.code // "not_enriched") end; def direction($sz; $dz): if $sz == "external" and $dz != "external" then "inbound" elif $sz != "external" and $dz == "external" then "outbound" else "internal" end; .src as $src | .dest as $dest | ($src | zone) as $sz | ($dest | zone) as $dz | ($dz | crit) as $dc | direction($sz; $dz) as $dir | (.enrichment.geo.src // null) as $gs | (.enrichment.geo.dest // null) as $gd | ($src | ti_listed) as $ti | (.severity_id | if type == "number" then . else (tonumber? // 0) end) as $sid | ((.signature // "") | tostring | ascii_downcase) as $sig | ((.url // "") | tostring | ascii_downcase) as $url | (.action == "blocked") as $blocked | (.secrets_redacted == true) as $cred | ($url | test("jndi:")) as $jndi | [(if $sid > 0 then "ids_severity" else empty end), (if $dc == "critical" then "critical_destination" elif $dc == "high" then "high_value_destination" else empty end), (if $ti then "threat_intel_source" else empty end), (if $sid >= 7 and ($blocked | not) then "high_severity_not_blocked" else empty end), (if $dir == "outbound" and $sid >= 7 then "outbound_high_severity" else empty end), (if $jndi then "jndi_in_url" else empty end), (if $cred then "credential_in_url" else empty end)] as $rf | {ids_severity: ($sid * 7), critical_destination: 15, high_value_destination: 10, threat_intel_source: 15, high_severity_not_blocked: 10, outbound_high_severity: 15, jndi_in_url: 20, credential_in_url: 15} as $w | ([$rf[] | $w[.]] | add // 0 | if . > 100 then 100 else . end) as $score | ([(if ($sig | test("(^|[^a-z])scan")) then "T1046" else empty end), (if ($sig | test("exploit|sql injection|sqli|log4j|jndi:")) or $jndi then "T1190" else empty end), (if ($sig | test("cobalt ?strike")) then "T1071.001" else empty end), (if ($sig | test("mimikatz")) then "T1003.001" else empty end), (if ($sig | test("[.]onion")) then "T1090.003" else empty end), (if ($sig | test("external ip|ip lookup|ip check")) then "T1016" else empty end), (if ($sig | test("(^|[^a-z])(exe|dll)([^a-z]|$)")) and ($sig | test("download")) then "T1105" else empty end), (if $cred then "T1552.001" else empty end)] | unique) as $mitre | (if $sid >= 4 or $score >= 50 then "hot" elif $sid >= 1 then "warm" else "cold" end) as $tier | . + {src_network_zone: $sz, dest_network_zone: $dz, direction: $dir, dest_asset_criticality: $dc, user_category: "unknown", src_country: ($gs | geo_country), dest_country: ($gd | geo_country), geo_status: {src: ($gs | geo_stat), dest: ($gd | geo_stat)}, threat_intel: {src_listed: $ti, source: "demo-static-blocklist"}, risk_factors: $rf, risk_score: $score, mitre_technique: $mitre, tier: $tier}
