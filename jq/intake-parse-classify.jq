((.msg // .message // "") | tostring) as $msg | (.["app-name"] // null) as $app | (.hostname // null) as $host | (.procid // null) as $procid | (.timestamp // null) as $ts | (.pri | if . == null or . == "" then null elif type == "number" then . else (tonumber? // null) end) as $pri | (if $pri == null then null else ($pri / 8 | floor) end) as $fac | (if $pri == null then null else ($pri % 8) end) as $sev | (if ($msg | test("^1,[^,]*,[^,]*,(TRAFFIC|THREAT),")) then "firewall" elif ($msg | test("CEF:[0-9]+[|]")) then "cef_alert" elif ($app != null and any("sshd", "sudo", "su", "CRON", "login", "systemd-logind"; . == $app)) then "linux_auth" else "unknown" end) as $dt | (($ts // "") | tostring) as $tss | (($host // "") | tostring) as $hs | (($app // "") | tostring) as $as | (($procid // "") | tostring) as $ps | ((if $pri == null then "" else "<" + ($pri | tostring) + ">" end) + $tss + " " + $hs + " " + $as + (if $ps == "" or $ps == "-" then "" else "[" + $ps + "]" end) + ": " + $msg) as $raw | {data_type: $dt, syslog: ({pri: $pri, facility: $fac, severity: $sev, severity_name: (if $sev == null then null else ["emergency", "alert", "critical", "error", "warning", "notice", "informational", "debug"][$sev] end), timestamp: $ts, host: $host, app: $app, procid: $procid} + (if .["structured-data"] then {structured_data: .["structured-data"]} else {} end)), message: $msg, _raw: $raw, _meta: {collector: "monad-syslog", intake_pipeline: "syslog-intake", intake_time: (now | todate), schema_version: "1.0"}}
