def redact_str: gsub("(?P<k>(password|passwd|access_token|client_secret|api_key|api-key|apikey|token|secret|pass|auth|sig)[[:punct:]]?=)[^&; ']+"; .k + "****"; "i") | gsub("(?P<k>--password[[:space:]]+)[^[:space:]]+"; .k + "****"; "i") | gsub("(?P<k>bearer[[:space:]]+)[^[:space:]&;']+"; .k + "****"; "i") | if test("mysql|mariadb"; "i") then gsub("(?P<k>(^|[[:space:]])-p)[^[:space:]]+"; .k + "****") else . end; def redact: . as $o | walk(if type == "string" then redact_str else . end) as $r | $r + {secrets_redacted: ($r != $o)}; ((.message // "") | tostring) as $m | ((.syslog.app // "") | tostring) as $app | (.syslog.host // null) as $h | (($m | capture("^Accepted (?P<method>[^ ]+) for (?P<user>[^ ]+) from (?P<src>[^ ]+) port (?P<port>[0-9]+)")) // {}) as $acc | (($m | capture("^Failed (?P<method>[^ ]+) for (?P<inv>invalid user )?(?P<user>[^ ]+) from (?P<src>[^ ]+) port (?P<port>[0-9]+)")) // {}) as $fail | (($m | capture("^Invalid user (?P<user>[^ ]*) from (?P<src>[^ ]+)( port (?P<port>[0-9]+))?")) // {}) as $inv | (($m | capture("session (?P<act>opened|closed) for user (?P<user>[^ (]+)")) // {}) as $sess | (($m | capture("^(?P<user>[^ :]+)[[:space:]]*:[[:space:]]*TTY=(?P<tty>[^;]*?)[[:space:]]*;[[:space:]]*PWD=(?P<cwd>[^;]*?)[[:space:]]*;[[:space:]]*USER=(?P<run_as>[^;]*?)[[:space:]]*;.*?COMMAND=(?P<command>.*)$")) // {}) as $sudo | . + {dest: $h, dvc: $h, app: $app, index: "os_auth", sourcetype: "linux_secure"} | (if $acc.user then . + {category: "authentication", action: "success", user: $acc.user, src: $acc.src, src_port: ($acc.port | tonumber), auth_method: $acc.method, user_valid: true} elif $fail.user then . + {category: "authentication", action: "failure", user: $fail.user, src: $fail.src, src_port: ($fail.port | tonumber), auth_method: $fail.method, user_valid: ((($fail.inv // "") | length) == 0)} elif $inv.user != null then . + {category: "authentication", action: "failure", user: $inv.user, src: $inv.src, src_port: ($inv.port | if . == null or . == "" then null else tonumber end), user_valid: false} elif $sess.user then . + {category: "session", action: $sess.act, user: $sess.user} elif $sudo.user then . + {category: "privilege_escalation", action: "success", user: $sudo.user, run_as: $sudo.run_as, tty: $sudo.tty, cwd: $sudo.cwd, command: $sudo.command} else . + {category: "other"} end) | redact
