def redact_str: gsub("(?P<k>(password|passwd|access_token|client_secret|api_key|api-key|apikey|token|secret|pass|auth|sig)[[:punct:]]?=)[^&; ']+"; .k + "****"; "i") | gsub("(?P<k>--password[[:space:]]+)[^[:space:]]+"; .k + "****"; "i") | gsub("(?P<k>bearer[[:space:]]+)[^[:space:]&;']+"; .k + "****"; "i") | if test("mysql|mariadb"; "i") then gsub("(?P<k>(^|[[:space:]])-p)[^[:space:]]+"; .k + "****") else . end; def redact: . as $o | walk(if type == "string" then redact_str else . end) as $r | $r + {secrets_redacted: ($r != $o)}; def sevlabel: if . == null then "informational" elif . >= 9 then "critical" elif . >= 7 then "high" elif . >= 4 then "medium" elif . >= 1 then "low" else "informational" end; (.cef_severity | if . == null then null elif type == "number" then . else (tonumber? // null) end) as $sid | (.deviceAction // null) as $va | . + {src: .sourceAddress, dest: .destinationAddress, src_port: .sourcePort, dest_port: .destinationPort, vendor_action: $va, action: (if (($va // "") | tostring | ascii_downcase) == "drop" then "blocked" else "allowed" end), category: .deviceEventCategory, dvc: .deviceHostName, url: .requestUrl, transport: (.transportProtocol | if type == "string" then ascii_downcase else . end), severity_id: $sid, severity: ($sid | sevlabel), index: "ids", sourcetype: "suricata:cef"} | redact
